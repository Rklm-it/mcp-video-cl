# --- required -------------------------------------------------------------
# Domain pointing to this VPS (A record). Caddy gets an HTTPS certificate for it.
DOMAIN=video.example.com
# Secret token. Generate: openssl rand -hex 32
VIDEO_MCP_TOKEN=change-me

# --- YouTube access from a datacenter IP (see README) ------------------------
# Netscape cookies.txt exported from a browser logged into a (spare) Google account.
# Put the file to ./secrets/cookies.txt on the host.
# YTDLP_COOKIES=/secrets/cookies.txt
# Residential/mobile proxy, e.g. socks5://user:pass@host:port
# YTDLP_PROXY=
# PO-token provider (docker compose --profile pot up -d)
# YTDLP_POT_PROVIDER_URL=http://pot-provider:4416
# Update yt-dlp on each container start (recommended)
YTDLP_AUTO_UPDATE=1

# --- Whisper (speech recognition when a video has no subtitles) ------------
# Build the image without Whisper to save ~1 GB: WITH_WHISPER=0
WITH_WHISPER=1
WHISPER_ENABLED=1
# tiny / base / small / medium / large-v3 (bigger = better but slower on CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- tuning (defaults are fine) -------------------------------------------
# VIDEO_MCP_MAX_HEIGHT=720
# VIDEO_MCP_LONG_VIDEO_MAX_HEIGHT=480
# VIDEO_MCP_LONG_VIDEO_MINUTES=60
# VIDEO_MCP_SECTION_DOWNLOAD_MINUTES=30
# VIDEO_MCP_MAX_DURATION_HOURS=6
# VIDEO_MCP_FRAME_WIDTH=768
# VIDEO_MCP_FRAME_MAX_WIDTH=1600
# VIDEO_MCP_JPEG_QUALITY=72
# VIDEO_MCP_TRANSCRIPT_MAX_CHARS=40000
# VIDEO_MCP_CACHE_TTL_HOURS=48
# VIDEO_MCP_CACHE_MAX_GB=15

# --- Reels factory: Claude writes scripts, the server makes and posts videos ---
# REELS_ENABLED=1
# Preset «Timeweb AI Gateway» (rubles, one key for voice and pictures):
#   REELS_TTS=openai
#   REELS_IMAGES=openai
#   REELS_OPENAI_BASE_URL=https://api.timeweb.ai/v1
#   REELS_OPENAI_API_KEY=<key from the AI Gateway panel>
#   REELS_OPENAI_IMAGE_MODEL=<image model name exactly as in the panel>
#   REELS_OPENAI_TTS_MODEL=openai/gpt-4o-mini-tts   # Timeweb wants the provider prefix, else it answers 500
#
# Voice: edge (free) | openai (OpenAI-compatible /audio/speech) | elevenlabs (paid, best quality)
# REELS_TTS=edge
# REELS_EDGE_VOICE=ru-RU-DmitryNeural        # or ru-RU-SvetlanaNeural
# REELS_EDGE_RATE=+8%
# REELS_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# REELS_OPENAI_TTS_VOICE=onyx                # nova, alloy, ash, coral…
# REELS_OPENAI_TTS_INSTRUCTIONS=Говори по-русски живо и уверенно, как ведущий коротких роликов, в бодром темпе.
# REELS_VOICE_SPEED=1.1                     # tempo after synthesis, pitch unchanged (1.0 = as generated)
# Pick a voice by ear: python -m video_mcp.reels.voice_samples  -> samples arrive in the review chat
# REELS_ELEVENLABS_API_KEY=
# REELS_ELEVENLABS_VOICE_ID=
# Pictures: pollinations (free) | gemini (Nano Banana via Gemini API, paid) | openai (any
# OpenAI-compatible images API) | placeholder (test)
# REELS_IMAGES=pollinations
# REELS_GEMINI_API_KEY=
# REELS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# REELS_GEMINI_AUTH=key                      # bearer for resellers that proxy the Gemini API
# REELS_OPENAI_API_KEY=
# REELS_OPENAI_BASE_URL=https://api.openai.com/v1
# REELS_OPENAI_IMAGE_MODEL=gpt-image-1
# REELS_OPENAI_IMAGE_SIZE=1024x1536          # empty if the model does not accept `size`
# REELS_SCENE_CONTEXT=                      # where scenes take place, added to picture and video prompts; default: present-day Russia, empty = off
# REELS_IMAGE_STYLE=vertical 9:16, cinematic, high detail, no text, no letters, no watermark
# AI video scenes: none | veo — Veo 3.1 through the Gemini API settings above |
#   openai — OpenAI-style /videos API (REELS_VIDEO_BASE_URL, REELS_VIDEO_API_KEY or the Gemini key).
# Preset «full video via ProxyAPI» (rubles). Veo 3.1 Lite is only in its unified API, not in /google/v1beta:
#   REELS_VIDEO=openai
#   REELS_VIDEO_BASE_URL=https://api.proxyapi.ru/v1
#   REELS_ANIMATE_ALL=1
#   REELS_GEMINI_API_KEY=<ProxyAPI key>
#   REELS_VEO_MODEL=google/veo-3.1-lite         # 720p 4,11 ₽/s; google/veo-3.1-fast 11,58 ₽/s
# REELS_VIDEO=none
# REELS_ANIMATE_ALL=0                        # 1 = every scene is AI video unless the script says otherwise
# REELS_VEO_MODEL=veo-3.1-lite-generate-preview   # with REELS_VIDEO=veo: the model name in that Gemini API
# REELS_VEO_RESOLUTION=720p
# REELS_MAX_ANIMATED=                        # per-reel limit; default 8 with ANIMATE_ALL, else 2
# REELS_VIDEO_WORKERS=4                      # clips generated in parallel
# Background music: folder with tracks you may use (e.g. YouTube Audio Library), mounted into the container
# REELS_MUSIC_DIR=/data/music
# REELS_MUSIC_VOLUME=0.12
# Days to keep video files of published reels (small VPS disks)
# REELS_KEEP_DAYS=3
# Telegram: create a bot with @BotFather, add it as admin to your channel.
# REELS_TG_BOT_TOKEN=
# REELS_TG_CHANNEL=@your_channel
# Your private chat with the bot (send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to see chat.id). Drafts arrive there with buttons.
# REELS_TG_REVIEW_CHAT_ID=
# YouTube: run `docker compose run --rm --entrypoint video-mcp-youtube-auth video-mcp`
# REELS_YT_CLIENT_ID=
# REELS_YT_CLIENT_SECRET=
# REELS_YT_REFRESH_TOKEN=
# REELS_YT_PRIVACY=public
# 0 = use the YouTube credentials only for analytics (youtube_stats), never upload
# REELS_YT_UPLOAD=1

# --- Photo bot «Оживи фото» (src/video_mcp/photobot): photo -> card / photoshoot / living video, paid via Platega ---
# Uses the reels image (REELS_GEMINI_*) and video (REELS_VIDEO*) settings above.
# COMPOSE_PROFILES=photobot
# PHOTO_BOT_TOKEN=
# PHOTO_BOT_ADMIN_ID=            # your Telegram user id: payment notices and /stats
# PLATEGA_MERCHANT_ID=
# PLATEGA_SECRET=
# PHOTO_BOT_IMAGE_MODEL=gemini-3-pro-image-preview   # Nano Banana Pro: faces stay recognisable, up to 14 reference photos
# PHOTO_BOT_PRICE_ANIMATE=149
# PHOTO_BOT_PRICE_CARD=99
# PHOTO_BOT_PRICE_SHOOT=199
# PHOTO_BOT_PRICE_GREET=199
# PHOTO_BOT_PRICE_MOROZ=299
# PHOTO_BOT_DED_MOROZ=0          # 1 = show Ded Moroz to everyone (the owner always sees it)
